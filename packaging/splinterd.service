[Unit]
Description=splinterd BLE privacy decoy
Documentation=https://github.com/zachsis/splinter-uconnectcm4
After=bluetooth.service

[Service]
ExecStart=/usr/local/bin/splinterd
Restart=on-failure
RestartSec=2

# Run unprivileged: CAP_NET_RAW is needed to create the AF_BLUETOOTH socket and
# CAP_NET_ADMIN to bind the HCI user/control channels. Both must be in the
# bounding set AND granted as ambient capabilities for a non-root User=.
User=splinter
Group=splinter
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=true

# While active, splinterd monopolizes the Bluetooth adapter (no BT audio, etc.).
# It hands the controller back to bluetoothd cleanly on stop.

[Install]
WantedBy=multi-user.target
